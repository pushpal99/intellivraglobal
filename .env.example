# ============================================================================
#  Intellivra Global - environment variables
#  Copy to .env for local experiments (.env is gitignored). NEVER commit real
#  keys. In production these live in the Netlify UI, not in this repo.
# ============================================================================

# --- Transactional email (used by netlify/functions/send-contact.js) --------
# Set in: Netlify > Site configuration > Environment variables
# Get a key from https://resend.com (API Keys). Required for the contact form.
EMAIL_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender. With Resend you must verify the domain first, otherwise use
# their sandbox sender. Format: "Display Name <address@domain>"
EMAIL_FROM=Intellivra Global <noreply@intellivraglobal.com>

# Which provider adapter to use: resend (default) or postmark.
EMAIL_PROVIDER=resend

# --- Netlify deploy (used by .github/workflows/deploy.yml) ------------------
# Set in: GitHub > Settings > Secrets and variables > Actions > Repository secrets
# NETLIFY_AUTH_TOKEN  Netlify user settings > Applications > Personal access tokens
# NETLIFY_SITE_ID     Netlify site > Site configuration > General > Site ID
NETLIFY_AUTH_TOKEN=nfp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NETLIFY_SITE_ID=00000000-0000-0000-0000-000000000000

# The recipient address is NOT an environment variable. It lives in
# config/site.yaml under contact.form_recipient, and the build injects it.
